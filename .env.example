# Root environment configuration for local docker-compose orchestration.
# Copy to .env and adjust as needed. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=arr_user
POSTGRES_PASSWORD=arr_password
POSTGRES_DB=arr_db
# 5433, not 5432: avoids colliding with a native Postgres install/service
# that may already be bound to 5432 on the host machine. This only affects
# the published host port -- containers still reach Postgres internally at
# postgres:5432.
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://arr_user:arr_password@postgres:5432/arr_db
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Frontend ---
FRONTEND_PORT=3000
# Not used by docker-compose (which hardcodes the in-network backend URL);
# only relevant when running the frontend outside Docker.
API_BASE_URL=http://localhost:8000
