# Root environment configuration for local docker-compose orchestration.
# Copy to .env and adjust as needed. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=arr_user
POSTGRES_PASSWORD=arr_password
POSTGRES_DB=arr_db
# 5433, not 5432: avoids colliding with a native Postgres install/service
# that may already be bound to 5432 on the host machine. This only affects
# the published host port -- containers still reach Postgres internally at
# postgres:5432.
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://arr_user:arr_password@postgres:5432/arr_db
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Frontend ---
FRONTEND_PORT=3000
# Not used by docker-compose (which hardcodes the in-network backend URL);
# only relevant when running the frontend outside Docker.
API_BASE_URL=http://localhost:8000

# --- Security & fintech hardening (Phase 15) ---
# "key:role,key:role" -- role is "operator" (full read/write) or
# "readonly" (GET endpoints only). Every mutating endpoint requires an
# operator key; production refuses to start with this unset
# (app.main.create_app). Generate real random keys for anything beyond
# local development -- these are placeholders.
API_KEYS_RAW=local-dev-operator-key:operator,local-dev-readonly-key:readonly
# The frontend calls the backend server-to-server and needs one operator
# key of its own (never sent to the browser -- see
# frontend/src/lib/backend-auth.ts). Must match one of the operator
# entries in API_KEYS_RAW above.
BACKEND_API_KEY=local-dev-operator-key
# Comma-separated browser origins allowed to call the API directly
# (CORS). Empty by default -- this bundled frontend does not need it
# (server-to-server only); set only for a separate browser client.
CORS_ALLOWED_ORIGINS_RAW=
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# --- Real payment integration (Phase 16) ---
# A Stripe TEST-mode secret key (sk_test_...) -- get one free at
# https://dashboard.stripe.com/test/apikeys. Unset by default: the
# `retry` recovery strategy falls back to the existing deterministic
# SimulatedPaymentProvider. A live key (sk_live_...) is refused at the
# point of use -- this platform never processes real payments.
STRIPE_API_KEY=
