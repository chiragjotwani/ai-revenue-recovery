# Backend-local environment overrides for running outside docker-compose.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://arr_user:arr_password@localhost:5433/arr_db
REDIS_URL=redis://localhost:6379/0
BACKEND_PORT=8000

# --- Reasoning model (Phase 4) ---
# "mock" (default, no model needed), "qwen", or "nemotron". If a real
# provider is selected but its base URL is blank, the app falls back to
# "mock". See docs/ai/local-model-setup.md.
REASONING_PROVIDER=mock
# AI_QWEN_BASE_URL=http://localhost:11434/v1
# AI_QWEN_MODEL=qwen3:4b
# AI_NEMOTRON_BASE_URL=
# AI_NEMOTRON_MODEL=nemotron-mini
# AI_REQUEST_TIMEOUT_SECONDS=60
